{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "vzt-agent-protocol",
  "version": "1.17.0",
  "description": "VZT Agent Protocol - Automatic model routing between Claude Fable 5, Opus 5, Sonnet 5, and Haiku 4.5 for Claude Code. Right model, right task, zero manual switching.",
  "keywords": [
    "claude-code",
    "model-routing",
    "agents",
    "fable",
    "opus",
    "sonnet",
    "haiku",
    "orchestration",
    "vzt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vonzelle-vzt/vzt-agent-protocol.git"
  },
  "license": "MIT",
  "author": "VZT Tech Consulting",
  "type": "module",
  "main": "cli/vzt-agent.js",
  "bin": {
    "vzt-agent": "cli/vzt-agent.js"
  },
  "files": [
    "agents/",
    "cli/",
    "docs/",
    "hooks/",
    "orca/",
    "scripts/",
    "skills/",
    "templates/",
    "workflows/",
    "vscode/",
    "vscode-paste-image/",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install:project": "node cli/vzt-agent.js install",
    "install:global": "node cli/vzt-agent.js install --global",
    "test": "node --test 'test/*.test.mjs'",
    "test:live": "node test/live/herdr-review-live.mjs",
    "doctor": "node cli/vzt-agent.js doctor",
    "codex:auto": "bash scripts/codex-full-auto.sh",
    "audit:root": "npm audit",
    "audit:vscode": "npm --prefix vscode audit",
    "compile:vscode": "npm --prefix vscode run compile",
    "package:vscode": "npm --prefix vscode run package",
    "install:vscode:local": "npm run package:vscode && code --uninstall-extension vzt.vzt-mux || true && VSIX=$(ls -t vscode/vzt-mux-*.vsix | head -n1) && code --install-extension \"$VSIX\" --force",
    "pack:dry": "npm pack --dry-run",
    "verify": "npm test && npm run audit:root && npm run audit:vscode && npm run compile:vscode && npm run pack:dry"
  },
  "engines": {
    "node": ">=18"
  }
}
