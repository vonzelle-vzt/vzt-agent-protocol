{
  "name": "vzt-mux",
  "displayName": "VZT Ship Mux",
  "description": "Runs VZT Agent Protocol ship units as native VS Code integrated terminals, with a live Ship Run tree — per-unit status, worktree diffs mid-run, and one-click oracle re-runs.",
  "version": "0.6.2",
  "publisher": "vzt",
  "icon": "media/ship-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vztShip",
          "title": "VZT Ship",
          "icon": "media/ship.svg"
        },
        {
          "id": "herdrFleet",
          "title": "Herdr Fleet",
          "icon": "media/fleet.svg"
        }
      ]
    },
    "views": {
      "vztShip": [
        {
          "id": "vztShipRun",
          "name": "Ship Run",
          "contextualTitle": "VZT Ship Run"
        }
      ],
      "herdrFleet": [
        {
          "id": "herdrFleet.agents",
          "name": "Agents",
          "contextualTitle": "Herdr Fleet"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vztShipRun",
        "contents": "No ship run yet.\n\nStart one with:\n[vzt-agent ship-watch <SPEC.md> --mux vscode]()\n\nEach unit opens as its own integrated terminal, and appears here with live status."
      },
      {
        "view": "herdrFleet.agents",
        "contents": "No herdr server running.\n\nStart one with:\n[herdr]()\n\nThe agents it runs will appear here, badged working / blocked / idle. herdr keeps owning them — closing this window does not stop them."
      }
    ],
    "commands": [
      {
        "command": "vzt-mux.watchShipRun",
        "title": "VZT: Watch Ship Run"
      },
      {
        "command": "vzt-mux.doctor",
        "title": "VZT: Doctor",
        "icon": "$(pulse)"
      },
      {
        "command": "vzt-mux.installProject",
        "title": "VZT: Install Protocol In This Project",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vzt-mux.installGlobal",
        "title": "VZT: Install Protocol Globally",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vzt-mux.openShipRun",
        "title": "VZT: Open Ship Run",
        "icon": "$(rocket)"
      },
      {
        "command": "vzt-mux.startShipWatchFromSpec",
        "title": "VZT: Start Ship Watch From Spec",
        "icon": "$(play)"
      },
      {
        "command": "vzt-mux.refresh",
        "title": "VZT: Refresh Ship Run",
        "icon": "$(refresh)"
      },
      {
        "command": "vzt-mux.focusTerminal",
        "title": "Focus Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "vzt-mux.openWorktree",
        "title": "Open Worktree Diff",
        "icon": "$(git-compare)"
      },
      {
        "command": "vzt-mux.rerunOracle",
        "title": "Re-run Oracle",
        "icon": "$(play)"
      },
      {
        "command": "vzt-mux.herdr.focusAgent",
        "title": "Herdr: Focus Agent"
      },
      {
        "command": "vzt-mux.herdr.refresh",
        "title": "Herdr: Refresh Fleet",
        "icon": "$(refresh)"
      },
      {
        "command": "vzt-mux.herdr.revealBlocked",
        "title": "Herdr: Reveal Blocked Agent"
      },
      {
        "command": "vzt-mux.herdr.reviewChanges",
        "title": "Herdr: Review Changes",
        "icon": "$(git-compare)"
      },
      {
        "command": "vzt-mux.herdr.sendReview",
        "title": "Herdr: Send Review Comments to Agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vzt-mux.herdr.discardReview",
        "title": "Herdr: Discard Review Comments"
      },
      {
        "command": "vzt-mux.herdr.addComment",
        "title": "Add Comment"
      },
      {
        "command": "vzt-mux.herdr.deleteThread",
        "title": "Delete Comment Thread",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "VZT Ship Mux",
      "properties": {
        "vztMux.baseDir": {
          "type": "string",
          "default": "",
          "description": "Filesystem contract directory for native VS Code ship runs. Empty means ~/.vzt/vscode-mux. VZT_VSCODE_DIR still wins when set."
        },
        "vztMux.autoDoctorOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Run a lightweight VZT readiness check when a VS Code workspace opens."
        },
        "vztMux.showSetupPrompts": {
          "type": "boolean",
          "default": true,
          "description": "Show a one-time setup prompt when a workspace opens without project or global VZT protocol hooks."
        },
        "vztMux.herdr.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the Herdr Fleet view. When off, no connection to the herdr daemon is made at all."
        },
        "vztMux.herdr.socketPath": {
          "type": "string",
          "default": "",
          "description": "Path to the herdr server socket. Empty means auto: $HERDR_SOCKET_PATH, else ~/.config/herdr/herdr.sock. Note this is the server socket, not herdr-client.sock."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "vzt-mux.doctor",
          "when": "view == vztShipRun",
          "group": "navigation"
        },
        {
          "command": "vzt-mux.refresh",
          "when": "view == vztShipRun",
          "group": "navigation@2"
        },
        {
          "command": "vzt-mux.herdr.refresh",
          "when": "view == herdrFleet.agents",
          "group": "navigation"
        },
        {
          "command": "vzt-mux.herdr.reviewChanges",
          "when": "view == herdrFleet.agents",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vzt-mux.focusTerminal",
          "when": "view == vztShipRun && viewItem == vztUnit",
          "group": "inline@1"
        },
        {
          "command": "vzt-mux.openWorktree",
          "when": "view == vztShipRun && viewItem == vztUnit",
          "group": "inline@2"
        },
        {
          "command": "vzt-mux.rerunOracle",
          "when": "view == vztShipRun && viewItem == vztUnit",
          "group": "inline@3"
        },
        {
          "command": "vzt-mux.herdr.sendReview",
          "when": "view == herdrFleet.agents && viewItem == herdrAgent",
          "group": "inline@1"
        },
        {
          "command": "vzt-mux.herdr.focusAgent",
          "when": "view == herdrFleet.agents && viewItem == herdrAgent",
          "group": "1_herdr@1"
        },
        {
          "command": "vzt-mux.herdr.sendReview",
          "when": "view == herdrFleet.agents && viewItem == herdrAgent",
          "group": "1_herdr@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "vzt-mux.herdr.addComment",
          "when": "commentController == vzt-mux.herdr.review",
          "group": "inline@1"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "vzt-mux.herdr.deleteThread",
          "when": "commentController == vzt-mux.herdr.review",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vzt-mux.herdr.addComment",
          "when": "false"
        },
        {
          "command": "vzt-mux.herdr.deleteThread",
          "when": "false"
        },
        {
          "command": "vzt-mux.herdr.focusAgent",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "gen:types": "node scripts/gen-herdr-types.mjs",
    "compile": "node scripts/gen-herdr-types.mjs && tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile && npx --yes @vscode/vsce package --no-dependencies -o vzt-mux-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.4.0"
  }
}
