{
  "name": "vzt-mux",
  "displayName": "VZT Ship Mux",
  "description": "Runs VZT Agent Protocol ship units as native VS Code integrated terminals, with a live Ship Run tree — per-unit status, worktree diffs mid-run, and one-click oracle re-runs.",
  "version": "0.11.1",
  "publisher": "vzt",
  "icon": "media/ship-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode VZT starts no agents, terminals or ship runs; its sidebar only offers to trust the workspace."
    }
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "terminal.integrated.rightClickBehavior": "paste",
      "terminal.integrated.copyOnSelection": true
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vztShip",
          "title": "VZT Ship",
          "icon": "media/ship.svg"
        },
        {
          "id": "herdrFleet",
          "title": "Herdr Fleet",
          "icon": "media/fleet.svg"
        }
      ]
    },
    "views": {
      "vztShip": [
        {
          "id": "vztProjects",
          "name": "Projects",
          "contextualTitle": "VZT Projects"
        },
        {
          "id": "vztShipRun",
          "name": "Ship Run",
          "contextualTitle": "VZT Ship Run"
        },
        {
          "id": "vztBus",
          "name": "Agent Bus",
          "contextualTitle": "VZT Agent Bus"
        }
      ],
      "herdrFleet": [
        {
          "id": "herdrFleet.agents",
          "name": "Agents",
          "contextualTitle": "Herdr Fleet"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vztShipRun",
        "contents": "No ship run yet.\n\nStart one with:\n[vzt-agent ship-watch <SPEC.md> --mux vscode]()\n\nEach unit opens as its own integrated terminal, and appears here with live status.",
        "when": "isWorkspaceTrusted"
      },
      {
        "view": "herdrFleet.agents",
        "contents": "No herdr server running.\n\nStart one with:\n[herdr]()\n\nThe agents it runs will appear here, badged working / blocked / idle. herdr keeps owning them — closing this window does not stop them.",
        "when": "isWorkspaceTrusted"
      },
      {
        "view": "vztBus",
        "contents": "No paired agents.\n\n[Pair Claude + Codex](command:vzt-mux.bus.pair)\n\nOpens Claude and Codex in split terminals, talking over the local VZT bus. Messages survive window reloads.",
        "when": "isWorkspaceTrusted"
      },
      {
        "view": "vztProjects",
        "contents": "No projects registered.\n\n[Add Project](command:vzt-mux.projects.add)\n\nClick a project to switch the terminal panel to its agents; its worktrees and the agents running in them appear here with live status, and + starts Claude, Codex or a terminal there.",
        "when": "isWorkspaceTrusted"
      },
      {
        "view": "vztProjects",
        "when": "!isWorkspaceTrusted",
        "contents": "This workspace is in Restricted Mode, so VZT starts no agents here.\n\n[Trust Workspace](command:workbench.trust.manage)\n\nOnce it is trusted, your projects, their worktrees and agents appear here, with + to start an agent."
      },
      {
        "view": "vztShipRun",
        "when": "!isWorkspaceTrusted",
        "contents": "Ship runs start only in a trusted workspace.\n\n[Trust Workspace](command:workbench.trust.manage)"
      },
      {
        "view": "vztBus",
        "when": "!isWorkspaceTrusted",
        "contents": "Agents start only in a trusted workspace.\n\n[Trust Workspace](command:workbench.trust.manage)"
      },
      {
        "view": "herdrFleet.agents",
        "when": "!isWorkspaceTrusted",
        "contents": "Herdr agents show only in a trusted workspace.\n\n[Trust Workspace](command:workbench.trust.manage)"
      }
    ],
    "commands": [
      {
        "command": "vzt-mux.watchShipRun",
        "title": "VZT: Watch Ship Run"
      },
      {
        "command": "vzt-mux.doctor",
        "title": "VZT: Doctor",
        "icon": "$(pulse)"
      },
      {
        "command": "vzt-mux.installProject",
        "title": "VZT: Install Protocol In This Project",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vzt-mux.installGlobal",
        "title": "VZT: Install Protocol Globally",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vzt-mux.openShipRun",
        "title": "VZT: Open Ship Run",
        "icon": "$(rocket)"
      },
      {
        "command": "vzt-mux.startShipWatchFromSpec",
        "title": "VZT: Start Ship Watch From Spec",
        "icon": "$(play)"
      },
      {
        "command": "vzt-mux.refresh",
        "title": "VZT: Refresh Ship Run",
        "icon": "$(refresh)"
      },
      {
        "command": "vzt-mux.focusTerminal",
        "title": "Focus Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "vzt-mux.openWorktree",
        "title": "Open Worktree Diff",
        "icon": "$(git-compare)"
      },
      {
        "command": "vzt-mux.rerunOracle",
        "title": "Re-run Oracle",
        "icon": "$(play)"
      },
      {
        "command": "vzt-mux.herdr.focusAgent",
        "title": "Herdr: Focus Agent"
      },
      {
        "command": "vzt-mux.herdr.refresh",
        "title": "Herdr: Refresh Fleet",
        "icon": "$(refresh)"
      },
      {
        "command": "vzt-mux.herdr.revealBlocked",
        "title": "Herdr: Reveal Blocked Agent"
      },
      {
        "command": "vzt-mux.herdr.reviewChanges",
        "title": "Herdr: Review Changes",
        "icon": "$(git-compare)"
      },
      {
        "command": "vzt-mux.herdr.sendReview",
        "title": "Herdr: Send Review Comments to Agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vzt-mux.herdr.discardReview",
        "title": "Herdr: Discard Review Comments"
      },
      {
        "command": "vzt-mux.herdr.addComment",
        "title": "Add Comment"
      },
      {
        "command": "vzt-mux.herdr.deleteThread",
        "title": "Delete Comment Thread",
        "icon": "$(trash)"
      },
      {
        "command": "vzt-mux.bus.pair",
        "title": "VZT: Pair Claude + Codex",
        "icon": "$(organization)"
      },
      {
        "command": "vzt-mux.bus.refresh",
        "title": "VZT: Refresh Agent Bus",
        "icon": "$(refresh)"
      },
      {
        "command": "vzt-mux.projects.refresh",
        "title": "VZT: Refresh Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "vzt-mux.projects.add",
        "title": "VZT: Add Project",
        "icon": "$(add)"
      },
      {
        "command": "vzt-mux.projects.importOrca",
        "title": "VZT: Import Projects from Orca",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vzt-mux.projects.remove",
        "title": "VZT: Remove Project",
        "icon": "$(trash)"
      },
      {
        "command": "vzt-mux.projects.openWindow",
        "title": "VZT: Open Project Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "vzt-mux.projects.focusAgent",
        "title": "VZT: Focus Agent",
        "icon": "$(terminal)"
      },
      {
        "command": "vzt-mux.projects.openWorktree",
        "title": "VZT: Open Worktree",
        "icon": "$(go-to-file)"
      },
      {
        "command": "vzt-mux.agents.newWorkspace",
        "title": "VZT: New Agent Workspace",
        "icon": "$(add)"
      },
      {
        "command": "vzt-mux.agents.addHere",
        "title": "VZT: Add Agent Here",
        "icon": "$(person-add)"
      },
      {
        "command": "vzt-mux.agents.startInProject",
        "title": "VZT: Start Agent or Terminal in Project",
        "icon": "$(add)"
      },
      {
        "command": "vzt-mux.workspace.create",
        "title": "VZT: Create Workspace from Projects",
        "icon": "$(new-folder)"
      },
      {
        "command": "vzt-mux.workspace.editProjects",
        "title": "VZT: Choose Projects in This Workspace",
        "icon": "$(checklist)"
      },
      {
        "command": "vzt-mux.dashboard.open",
        "title": "VZT: Open Agent Dashboard",
        "icon": "$(dashboard)"
      }
    ],
    "configuration": {
      "title": "VZT Ship Mux",
      "properties": {
        "vztMux.baseDir": {
          "type": "string",
          "default": "",
          "description": "Filesystem contract directory for native VS Code ship runs. Empty means ~/.vzt/vscode-mux. VZT_VSCODE_DIR still wins when set."
        },
        "vztMux.autoDoctorOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Run a lightweight VZT readiness check when a VS Code workspace opens."
        },
        "vztMux.showSetupPrompts": {
          "type": "boolean",
          "default": true,
          "description": "Show a one-time setup prompt when a workspace opens without project or global VZT protocol hooks."
        },
        "vztMux.herdr.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the Herdr Fleet view. When off, no connection to the herdr daemon is made at all."
        },
        "vztMux.herdr.socketPath": {
          "type": "string",
          "default": "",
          "description": "Path to the herdr server socket. Empty means auto: $HERDR_SOCKET_PATH, else ~/.config/herdr/herdr.sock. Note this is the server socket, not herdr-client.sock."
        },
        "vztMux.busCommand": {
          "type": "string",
          "default": "",
          "description": "Command prefix that runs vzt-agent for the agent bus, e.g. `vzt-agent` or `node /path/to/cli/vzt-agent.js`. Empty means auto: `command -v vzt-agent` in your login shell, else the CLI of the repo checkout this extension was built from."
        },
        "vztMux.attention.notify": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when an agent in this window turns needs-you or done. The status-bar count shows either way."
        },
        "vztMux.agents.restore": {
          "type": "boolean",
          "default": true,
          "description": "After a reload or restart, bring back the agents this window started: take back the tmux session that still runs an agent (or the terminal, for agents started without tmux), else resume the agent's last session."
        },
        "vztMux.agents.tmux": {
          "type": "boolean",
          "default": true,
          "description": "Run new agents and project terminals in tmux sessions on a private server (tmux -L vzt-mux, ~/.vzt/mux/tmux.conf; your own tmux is never touched). VS Code terminals are then only attach clients: switching projects swaps them without stopping anything, and agents outlive the window. Off, or with no tmux installed, agents run in plain terminals that close with the window."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "vzt-mux.doctor",
          "when": "view == vztShipRun",
          "group": "navigation"
        },
        {
          "command": "vzt-mux.refresh",
          "when": "view == vztShipRun",
          "group": "navigation@2"
        },
        {
          "command": "vzt-mux.herdr.refresh",
          "when": "view == herdrFleet.agents",
          "group": "navigation"
        },
        {
          "command": "vzt-mux.herdr.reviewChanges",
          "when": "view == herdrFleet.agents",
          "group": "navigation"
        },
        {
          "command": "vzt-mux.bus.pair",
          "when": "view == vztBus",
          "group": "navigation"
        },
        {
          "command": "vzt-mux.bus.refresh",
          "when": "view == vztBus",
          "group": "navigation@2"
        },
        {
          "command": "vzt-mux.projects.refresh",
          "when": "view == vztProjects",
          "group": "navigation@4"
        },
        {
          "command": "vzt-mux.projects.add",
          "when": "view == vztProjects",
          "group": "navigation@1"
        },
        {
          "command": "vzt-mux.projects.importOrca",
          "when": "view == vztProjects",
          "group": "navigation@5"
        },
        {
          "command": "vzt-mux.agents.newWorkspace",
          "when": "view == vztProjects",
          "group": "navigation@2"
        },
        {
          "command": "vzt-mux.dashboard.open",
          "when": "view == vztProjects",
          "group": "navigation@3"
        },
        {
          "command": "vzt-mux.workspace.editProjects",
          "when": "view == vztProjects && workbenchState == workspace",
          "group": "navigation@0"
        },
        {
          "command": "vzt-mux.workspace.create",
          "when": "view == vztProjects",
          "group": "1_workspace@1"
        }
      ],
      "view/item/context": [
        {
          "command": "vzt-mux.focusTerminal",
          "when": "view == vztShipRun && viewItem == vztUnit",
          "group": "inline@1"
        },
        {
          "command": "vzt-mux.openWorktree",
          "when": "view == vztShipRun && viewItem == vztUnit",
          "group": "inline@2"
        },
        {
          "command": "vzt-mux.rerunOracle",
          "when": "view == vztShipRun && viewItem == vztUnit",
          "group": "inline@3"
        },
        {
          "command": "vzt-mux.herdr.sendReview",
          "when": "view == herdrFleet.agents && viewItem == herdrAgent",
          "group": "inline@1"
        },
        {
          "command": "vzt-mux.herdr.focusAgent",
          "when": "view == herdrFleet.agents && viewItem == herdrAgent",
          "group": "1_herdr@1"
        },
        {
          "command": "vzt-mux.herdr.sendReview",
          "when": "view == herdrFleet.agents && viewItem == herdrAgent",
          "group": "1_herdr@2"
        },
        {
          "command": "vzt-mux.agents.startInProject",
          "when": "view == vztProjects && viewItem == vztProject",
          "group": "inline@0"
        },
        {
          "command": "vzt-mux.agents.addHere",
          "when": "view == vztProjects && viewItem == vztWorktree",
          "group": "inline@0"
        },
        {
          "command": "vzt-mux.projects.openWindow",
          "when": "view == vztProjects && viewItem == vztProject",
          "group": "1_project@0"
        },
        {
          "command": "vzt-mux.projects.remove",
          "when": "view == vztProjects && viewItem == vztProject",
          "group": "1_project@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "vzt-mux.herdr.addComment",
          "when": "commentController == vzt-mux.herdr.review",
          "group": "inline@1"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "vzt-mux.herdr.deleteThread",
          "when": "commentController == vzt-mux.herdr.review",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vzt-mux.herdr.addComment",
          "when": "false"
        },
        {
          "command": "vzt-mux.herdr.deleteThread",
          "when": "false"
        },
        {
          "command": "vzt-mux.herdr.focusAgent",
          "when": "false"
        },
        {
          "command": "vzt-mux.projects.openWorktree",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "vzt-mux.agents.newWorkspace",
          "when": "explorerResourceIsRoot",
          "group": "0_vzt@1"
        }
      ]
    }
  },
  "scripts": {
    "gen:types": "node scripts/gen-herdr-types.mjs",
    "compile": "node scripts/gen-herdr-types.mjs && tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile && npx --yes @vscode/vsce package --no-dependencies -o vzt-mux-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.4.0"
  }
}
